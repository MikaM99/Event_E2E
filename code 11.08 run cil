def load_data(data_paths:dict, D:torch.device):
    # Load Data
    # "großes" array je datentyp
    images_train = torch.Tensor().to(D)
    events_train = torch.Tensor().to(D)
    meta_train = torch.Tensor().to(D)
    # "großes" array je datentyp
    images_test = torch.Tensor().to(D)
    events_test = torch.Tensor().to(D)
    meta_test = torch.Tensor().to(D)
    all_speeds = []
    all_steers = []
    

    # os.path.isdir(path)
    for key in data_paths:
        data_path = data_paths[key]
        test = True 
        print(key)
        for folder in os.listdir(data_path):
            torch.cuda.empty_cache()
            folder_path = os.path.join(data_path, folder)
            if os.path.isdir(folder_path) and "_export" in folder:
                images = torch.Tensor().to(D)
                events = torch.Tensor().to(D)
                meta = torch.Tensor().to(D)
                print(folder_path)
                for dir in os.listdir(folder_path):
                    #print(dir)
                    if dir == "images":
                        p = os.path.join(folder_path, dir)
                        for file in os.listdir(p):
                            #print(file)
                            image_path = os.path.join(p, file)
                            #print(image_path)
                            image = Image.open(image_path).convert("RGB")
                            #print(type(image))
                            image = np.array(image)
                            image = image / 255.0
                            image = image[:, :, 0]
                            image = np.expand_dims(image, axis=0)
                            #arr=arr.reshape #stellen anpassen#chat swapaxes
                            #image = np.transpose(image, (2,)
                            #print(image[0,:,:]== image[1,:,:],image[2,:,:]== image[1,:,:])
                            if images.numel() == 0:
                                images = torch.Tensor(image).unsqueeze(0).to(D)
                            else:
                                images = torch.cat((images, torch.Tensor(image).unsqueeze(0).to(D)), dim=0)
                            #print(arr.shape)
                    elif dir == "events":
                        p = os.path.join(folder_path, dir)
                        for file in os.listdir(p):
                            #print(file)
                            event_path = os.path.join(p, file)
                            #print(event_path)
                            img = Image.open(event_path).convert("RGB")
                            img = np.array(img)/255.0
                            img = img[:, :, 0]
                            #print(type(events))
                            img = np.array(img)
                            img = np.expand_dims(img, axis=0)
                            #print(img[0,:,:]== img[1,:,:],img[2,:,:]== img[1,:,:])
                            if events.numel() == 0:
                                events = torch.Tensor(img).unsqueeze(0).to(D)
                            else:
                                events = torch.cat((events, torch.Tensor(img).unsqueeze(0).to(D)), dim=0)
                    elif dir == "meta":
                        p = os.path.join(folder_path, dir)
                        for file in os.listdir(p):
                            meta_path = os.path.join(p, file)
                            # Ergebnis: [0, 0, 0, 0, raw_data[2]["vehicle_speed"]] <- für jedes element in raw_data[2]
                            with open(meta_path) as json_file:
                                data = json.load(json_file) # data ist ein dict
                                #s = data["vehicle_speed"] 
                                #a = data["steering_wheel_angle"] 
                                speed_min = 0.0
                                speed_max = 65
                                steer_min = -600
                                steer_max = 600
                                s_raw = data["vehicle_speed"]
                                a_raw = data["steering_wheel_angle"]
                                s = (s_raw - speed_min) / (speed_max - speed_min)
                                a = (a_raw - steer_min) / (steer_max - steer_min)

                                all_speeds.append(s) 
                                all_steers.append(a)
                                tmp_array = torch.Tensor ([s, a]).to(D)
                                tmp_array = torch.Tensor([s, a]).to(D)
                                if meta.shape[0] == 0:
                                    meta = tmp_array.unsqueeze(0)
                                    #print(meta, meta.shape)
                                else:
                                    meta = torch.cat((meta, tmp_array.unsqueeze(0)), dim=0)
                                    #print(meta, meta.shape)
                if test:
                    images_test = torch.cat((images_test, images), dim=0)
                    events_test = torch.cat((events_test, events), dim=0)
                    meta_test = torch.cat((meta_test, meta), dim=0)
                    test = False
                else:
                    images_train = torch.cat((images_train, images), dim=0)
                    events_train = torch.cat((events_train, events), dim=0)
                    meta_train = torch.cat((meta_train, meta), dim=0)                
                #print(len(images), len(events), len(meta))

                #print(range(len(meta)))
                #for key in meta[50].keys():
                    #print(meta[50][key])

    #for key in dict_images.keys():
            #print(dict_images[key])
        # optional: große arrays mit np.save() als .npy abspeichern

                #name = folder.split("_")[0]
                #if test:
                    #torch.save(images, f"dataloader/test/images_{name}.pt")
                    #torch.save(meta, f"dataloader/test/meta_{name}.pt")
                    #torch.save(events, f"dataloader/test/events_{name}.pt")
                    #test = False
                #else:
                    #torch.save(images, f"dataloader/train/images_{name}.pt")
                    #torch.save(meta, f"dataloader/train/meta_{name}.pt")
                    #torch.save(events, f"dataloader/train/events_{name}.pt")
    print("Speed min:", min(all_speeds))
    print("Speed max:", max(all_speeds))

    print("Steer min:", min(all_steers))
    print("Steer max:", max(all_steers))
    #hier normalisieren

    return images_train, events_train, meta_train, images_test, events_test, meta_test

