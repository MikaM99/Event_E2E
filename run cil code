#Erstellung leerer Tensoren nach Datentyp + Listen zum Sammeln der Rohwerte
def load_data(data_paths:dict, D:torch.device):
   
    images = torch.Tensor().to(D)
    events = torch.Tensor().to(D)
    meta = torch.Tensor().to(D)
    all_speeds = []
    all_steers = []

   # Iteration über Datensätze, leeren des GPU Speichers, zurücksetzen der Tensoren für jede Aufnahme
    for key in data_paths:
        data_path = data_paths[key]
        print(key)
        for folder in os.listdir(data_path):
            torch.cuda.empty_cache()
            folder_path = os.path.join(data_path, folder)
            if os.path.isdir(folder_path) and "_export" in folder:
                images = torch.Tensor().to(D)
                events = torch.Tensor().to(D)
                meta = torch.Tensor().to(D)
                print(folder_path)
                for dir in os.listdir(folder_path):
                    #print(dir)
#Bild laden und in RGB konvertieren, in numpy array wandeln und pixelwerte auf 0,1 normaliesieren
#Umordnung von h,w,c in c,h,w für pytorch, ertsllen eines tensors
                    if dir == "images":
                        p = os.path.join(folder_path, dir)
                        for file in os.listdir(p):
                            #print(file)
                            image_path = os.path.join(p, file)
                            #print(image_path)
                            image = Image.open(image_path).convert("RGB")
                            #print(type(image))
                            image = np.array(image)
                            image = image / 255.0
                            #arr=arr.reshape #stellen anpassen#chat swapaxes
                            image = np.transpose(image, (2,0,1))
                            if images.shape == 0:
                                images = torch.Tensor(image).unsqueeze(0).to(D)
                            else:
                                images = torch.cat((images, torch.Tensor(image).unsqueeze(0).to(D)), dim=0)
                            #print(arr.shape)
#Event-Daten werden als Bilder geladen, auch in numpy array wandeln und umordnen, tensor erstellen
                    elif dir == "events":
                        p = os.path.join(folder_path, dir)
                        for file in os.listdir(p):
                            #print(file)
                            event_path = os.path.join(p, file)
                            #print(event_path)
                            img = Image.open(event_path).convert("RGB")
                            #print(type(events))
                            img = np.array(img)
                            img = np.transpose(img, (2,0,1))
                            if events.shape == 0:
                                events = torch.Tensor(img).unsqueeze(0).to(D)
                            else:
                                events = torch.cat((events, torch.Tensor(img).unsqueeze(0).to(D)), dim=0)
#s_raw.. fahrzeugzustände, Normalisierung ihrer
                    elif dir == "meta":
                        p = os.path.join(folder_path, dir)
                        for file in os.listdir(p):
                            meta_path = os.path.join(p, file)
                            # Ergebnis: [0, 0, 0, 0, raw_data[2]["vehicle_speed"]] <- für jedes element in raw_data[2]
                            with open(meta_path) as json_file:
                                data = json.load(json_file) # data ist ein dict
                                #s = data["vehicle_speed"] 
                                #a = data["steering_wheel_angle"] 
                                speed_min = 0.0
                                speed_max = 62
                                steer_min = -500
                                steer_max = 500
                                s_raw = data["vehicle_speed"]
                                a_raw = data["steering_wheel_angle"]
                                s = (s_raw - speed_min) / (speed_max - speed_min)
                                a = 2 * (a_raw - steer_min) / (steer_max - steer_min) - 1
#speichern der normalisierten werte, zusammenführen von speed und steer zu einem tensor, input für cil modell
                                all_speeds.append(s) 
                                all_steers.append(a)
                                tmp_array = torch.Tensor([s, a]).to(D)
                                if meta.shape[0] == 0:
                                    meta = tmp_array.unsqueeze(0)
                                    #print(meta, meta.shape)
                                else:
                                    meta = torch.cat((meta, tmp_array.unsqueeze(0)), dim=0)
                                    #print(meta, meta.shape)
                        
                #print(len(images), len(events), len(meta))
                #print(range(len(meta)))
